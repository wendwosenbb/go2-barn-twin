# Copy to infra/config.env and fill in. config.env is git-ignored.
#
#   cp infra/config.env.example infra/config.env
#
# Every script sources this file, then refuses to run unless the
# credentials it is using belong to EXPECTED_ACCOUNT_ID. That guard is
# what stops a GPU instance from ever landing on the wrong (e.g. company)
# AWS account.

AWS_PROFILE=isaac                 # named CLI profile for your personal account
AWS_REGION=us-east-2              # Ohio: closest major region to the Midwest
EXPECTED_ACCOUNT_ID=000000000000  # your 12-digit personal account ID

NAME=isaac-sim-ws                 # Name tag for the instance and its volumes
INSTANCE_TYPE=g6.2xlarge          # 8 vCPU, 32 GB RAM, NVIDIA L4 24 GB (Isaac Sim minimum: 32 GB RAM, 16 GB VRAM)
KEY_NAME=isaac-sim-ws             # EC2 key pair; private key saved to ~/.ssh/${KEY_NAME}.pem
SG_NAME=isaac-sim-ws-sg           # security group: SSH from your IP only, no Isaac Sim ports

ROOT_GB=60                        # OS + NVIDIA driver; deleted if the instance is terminated
DATA_GB=150                       # Docker images + Isaac Sim caches; survives termination
