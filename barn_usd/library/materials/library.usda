#usda 1.0
(
    defaultPrim = "_mat_Plastic"
    metersPerUnit = 1
    upAxis = "Z"
)

def Material "_mat_Plastic"
{
    token outputs:surface.connect = </_mat_Plastic/Shader.outputs:surface>

    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
        float inputs:metallic = 0
        float inputs:roughness = 0.55
        token outputs:surface
    }
}

def Material "_mat_Metal"
