#usda 1.0
(
    defaultPrim = "DrinkerNipple"
    metersPerUnit = 1
    upAxis = "Z"
)

over Xform "DrinkerNipple"
{
    over "Geom"
    {
        over "Full"
        {
            over "Cup" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "Nipple" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }
        }
    }
}

