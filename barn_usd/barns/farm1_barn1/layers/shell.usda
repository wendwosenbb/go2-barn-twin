#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def Xform "Barn" (
        kind = "assembly"
    )
    {
        def Xform "Shell" (
            customData = {
                dictionary barn = {
                    string source = "survey/barn.yaml"
                }
            }
            kind = "group"
        )
        {
            def Scope "Looks"
            {
                class "_mat_Bedding" (
                    prepend references = @../../../library/materials/library.usda@</_mat_Bedding>
                )
                {
                }

                def Material "Floor" (
                    prepend specializes = </World/Barn/Shell/Looks/_mat_Bedding>
                )
                {
                }

                class "_mat_Metal" (
                    prepend references = @../../../library/materials/library.usda@</_mat_Metal>
                )
                {
                }

                def Material "Wall" (
                    prepend specializes = </World/Barn/Shell/Looks/_mat_Metal>
                )
                {
                    over "Shader"
                    {
                        color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
                        float inputs:metallic = 0.2
                    }
                }

                def Material "Roof" (
                    prepend specializes = </World/Barn/Shell/Looks/_mat_Metal>
                )
                {
                    over "Shader"
                    {
                        color3f inputs:diffuseColor = (0.7, 0.71, 0.72)
                        float inputs:metallic = 0.3
                    }
                }
            }

            def Mesh "Floor" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom bool barn:allowBelowFloor = 1
                float3[] extent = [(-1.1, -8.17, -0.15), (154.5, 4.93, 0)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </World/Barn/Shell/Looks/Floor>
                point3f[] points = [(-1.1, -8.17, -0.15), (-1.1, 4.93, -0.15), (-1.1, 4.93, 0), (-1.1, -8.17, 0), (154.5, -8.17, -0.15), (154.5, 4.93, -0.15), (154.5, 4.93, 0), (154.5, -8.17, 0)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Wall_YNeg" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1.1, -8.17, 0), (154.5, -8.02, 2.65)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </World/Barn/Shell/Looks/Wall>
                point3f[] points = [(-1.1, -8.17, 0), (-1.1, -8.02, 0), (-1.1, -8.02, 2.65), (-1.1, -8.17, 2.65), (154.5, -8.17, 0), (154.5, -8.02, 0), (154.5, -8.02, 2.65), (154.5, -8.17, 2.65)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Wall_YPos" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1.1, 4.78, 0), (154.5, 4.93, 2.65)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </World/Barn/Shell/Looks/Wall>
                point3f[] points = [(-1.1, 4.78, 0), (-1.1, 4.93, 0), (-1.1, 4.93, 2.65), (-1.1, 4.78, 2.65), (154.5, 4.78, 0), (154.5, 4.93, 0), (154.5, 4.93, 2.65), (154.5, 4.78, 2.65)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Wall_XNeg" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1.1, -8.17, 0), (-0.95, 4.93, 3.5)]
                int[] faceVertexCounts = [5, 5, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [4, 3, 2, 1, 0, 5, 6, 7, 8, 9, 0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7, 3, 4, 9, 8, 4, 0, 5, 9]
                rel material:binding = </World/Barn/Shell/Looks/Wall>
                point3f[] points = [(-1.1, -8.17, 0), (-1.1, 4.93, 0), (-1.1, 4.93, 2.630078), (-1.1, -1.62, 3.5), (-1.1, -8.17, 2.630078), (-0.95, -8.17, 0), (-0.95, 4.93, 0), (-0.95, 4.93, 2.630078), (-0.95, -1.62, 3.5), (-0.95, -8.17, 2.630078)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Wall_XPos" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(154.35, -8.17, 0), (154.5, 4.93, 3.5)]
                int[] faceVertexCounts = [5, 5, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [4, 3, 2, 1, 0, 5, 6, 7, 8, 9, 0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7, 3, 4, 9, 8, 4, 0, 5, 9]
                rel material:binding = </World/Barn/Shell/Looks/Wall>
                point3f[] points = [(154.35, -8.17, 0), (154.35, 4.93, 0), (154.35, 4.93, 2.630078), (154.35, -1.62, 3.5), (154.35, -8.17, 2.630078), (154.5, -8.17, 0), (154.5, 4.93, 0), (154.5, 4.93, 2.630078), (154.5, -1.62, 3.5), (154.5, -8.17, 2.630078)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Roof_YNeg" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1.4, -8.47, 2.5902343), (154.8, -1.62, 3.55)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </World/Barn/Shell/Looks/Roof>
                point3f[] points = [(-1.4, -8.47, 2.5902343), (-1.4, -1.62, 3.5), (-1.4, -1.62, 3.55), (-1.4, -8.47, 2.6402345), (154.8, -8.47, 2.5902343), (154.8, -1.62, 3.5), (154.8, -1.62, 3.55), (154.8, -8.47, 2.6402345)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Roof_YPos" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                float3[] extent = [(-1.4, -1.62, 2.5902343), (154.8, 5.23, 3.55)]
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [3, 2, 1, 0, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
                rel material:binding = </World/Barn/Shell/Looks/Roof>
                point3f[] points = [(-1.4, -1.62, 3.5), (-1.4, 5.23, 2.5902343), (-1.4, 5.23, 2.6402345), (-1.4, -1.62, 3.55), (154.8, -1.62, 3.5), (154.8, 5.23, 2.5902343), (154.8, 5.23, 2.6402345), (154.8, -1.62, 3.55)]
                uniform token subdivisionScheme = "none"
            }
        }
    }
}

