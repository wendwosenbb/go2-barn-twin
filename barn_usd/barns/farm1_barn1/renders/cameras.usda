#usda 1.0
(
    doc = "Inspection views of farm1_barn1: barn.usda plus a sun and named cameras. Open in usdview and pick a camera from Camera menu."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [@../barn.usda@]
)

over "World"
{
    def Scope "Inspection"
    {
        def DistantLight "Sun"
        {
            float inputs:intensity = 2.5
            float3 xformOp:rotateXYZ = (45, 0, 35)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }

        def Camera "Cam_01_Outside"
        {
            float focalLength = 20
            float2 clippingRange = (0.5, 1000)
            double3 xformOp:translate = (-25, -30, 22)
            float3 xformOp:rotateXYZ = (62, 0, -55)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def Camera "Cam_02_FromOrigin"
        {
            float focalLength = 14
            float2 clippingRange = (0.05, 300)
            double3 xformOp:translate = (0.3, -1.6, 1.5)
            float3 xformOp:rotateXYZ = (84, 0, -90)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def Camera "Cam_03_FeederLine"
        {
            float focalLength = 20
            float2 clippingRange = (0.05, 300)
            double3 xformOp:translate = (20, -3.2, 0.9)
            float3 xformOp:rotateXYZ = (68, 0, -120)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def Camera "Cam_04_DrinkerLine"
        {
            float focalLength = 24
            float2 clippingRange = (0.02, 100)
            double3 xformOp:translate = (30, -1.65, 0.6)
            float3 xformOp:rotateXYZ = (70, 0, -60)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def Camera "Cam_05_TopDownFront"
        {
            float focalLength = 10
            float2 clippingRange = (0.05, 100)
            double3 xformOp:translate = (6, -1.6, 3.3)
            float3 xformOp:rotateXYZ = (0, 0, -90)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

        def Camera "Cam_06_Curtain"
        {
            float focalLength = 14
            float2 clippingRange = (0.05, 300)
            double3 xformOp:translate = (70, -1.6, 1.5)
            float3 xformOp:rotateXYZ = (84, 0, -90)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }
    }
}
