    no_delete = true
)
{
    float2 clippingRange = (0.01, 10000000)
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
    float focalLength = 18.147562
    float focusDistance = 400
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -6.84239676527063)
    float3 xformOp:rotateXYZ = (53.35369, -1.3138424e-14, -179.91356)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (-0.008282712821710905, 5.489890744181198, 4.084045767828609)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

def Xform "World"
{
    def DistantLight "Light"
    {
        float inputs:intensity = 1000
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Plane "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double length = 30
        double width = 30
    }

    def Cube "Obstacle"
    {
        double size = 2
        double3 xformOp:translate = (4.100000061094761, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "SimpleRobot" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0.375)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Cube" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (2, 1, 0.5)
            uniform token[] xformOpOrder = ["xformOp:scale"]

            def PhysicsFixedJoint "Sensor_Joint"
            {
                rel physics:body0 = </World/SimpleRobot/Cube>
                rel physics:body1 = </World/SimpleRobot/Front_Sensor>
                point3f physics:localPos0 = (0.45, 0, 0.6)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        def Xform "Front_Sensor" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
        )
        {
            double3 xformOp:translate = (0.9, 0, 0.3)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Sensor_Mount" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                float3 xformOp:scale = (0.1, 0.1, 0.1)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }

            def Camera "Camera" (
                prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
            )
            {
                float2 clippingRange = (0.01, 10000000)
                float exposure:fStop = 5
                float exposure:responsivity = 1.1026709
                float exposure:time = 0.02
                float focalLength = 18.147562
                quatd xformOp:orient = (0.5, 0.5, -0.5, -0.5)
                double3 xformOp:translate = (0.06, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }

            def OmniLidar "Lidar" (
                prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.1/Isaac/Sensors/NVIDIA/Example_Rotary_2D.usda@
            )
            {
                custom string[] _replicator:rendervar:GenericModelOutput:channels = ["NONE"]
                bool omni:sensor:Core:accumulateOutputs = 1
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        def Cylinder "front_left_wheel" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double height = 1
            rel material:binding:physics = </World/PhysicsMaterials/slippery> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double radius = 0.5
            float3 xformOp:rotateXYZ = (90, 0, 0)
            float3 xformOp:scale = (0.75, 0.75, 0.25)
            double3 xformOp:translate = (0.5, 0.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Cylinder "front_right_wheel" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            double height = 1
            rel material:binding:physics = </World/PhysicsMaterials/slippery> (
                bindMaterialAs = "weakerThanDescendants"
            )
            double radius = 0.5
            float3 xformOp:rotateXYZ = (90, 0, 0)
            float3 xformOp:scale = (0.75, 0.75, 0.25)
            double3 xformOp:translate = (0.5, -0.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Cylinder "back_left_wheel" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            double height = 1
            double radius = 0.5
            float3 xformOp:rotateXYZ = (90, 0, 0)
            float3 xformOp:scale = (0.75, 0.75, 0.25)
            double3 xformOp:translate = (-0.5, 0.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Cylinder "back_right_wheel" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            double height = 1
            double radius = 0.5
            float3 xformOp:rotateXYZ = (90, 0, 0)
            float3 xformOp:scale = (0.75, 0.75, 0.25)
            double3 xformOp:translate = (-0.5, -0.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def PhysicsRevoluteJoint "FrontLeftJoint"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/SimpleRobot/Cube>
            rel physics:body1 = </World/SimpleRobot/front_left_wheel>
            point3f physics:localPos0 = (0.25, 0.75, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (0.70710677, -0.70710677, -0, -0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
        }

        def PhysicsRevoluteJoint "FrontRightJoint"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/SimpleRobot/Cube>
            rel physics:body1 = </World/SimpleRobot/front_right_wheel>
            point3f physics:localPos0 = (0.25, -0.75, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (0.70710677, -0.70710677, -0, -0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
        }

        def PhysicsRevoluteJoint "BackLeftJoint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 50
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/SimpleRobot/Cube>
            rel physics:body1 = </World/SimpleRobot/back_left_wheel>
            point3f physics:localPos0 = (-0.25, 0.75, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (0.70710677, -0.70710677, -0, -0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
        }

        def PhysicsRevoluteJoint "BackRightJoint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 10000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 50
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/SimpleRobot/Cube>
            rel physics:body1 = </World/SimpleRobot/back_right_wheel>
            point3f physics:localPos0 = (-0.25, -0.75, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (0.70710677, -0.70710677, -0, -0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
        }
    }

    def "PhysicsMaterials"
    {
        def Material "slippery" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.1
            float physics:restitution = 0
            float physics:staticFriction = 0.1
        }
    }

    def OmniGraph "DiffDriveGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "tick"
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "diff"
        {
            custom double inputs:angularVelocity = 0
            custom double inputs:dt
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/DiffDriveGraph/tick.outputs:tick>
            custom double inputs:linearVelocity = 1
            custom double inputs:maxAcceleration
            custom double inputs:maxAngularAcceleration
            custom double inputs:maxAngularSpeed
            custom double inputs:maxDeceleration
            custom double inputs:maxLinearSpeed
            custom double inputs:maxWheelSpeed
            custom double inputs:wheelDistance = 1.5
            custom double inputs:wheelRadius = 0.375
            token node:type = "isaacsim.robot.wheeled_robots.DifferentialController"
            int node:typeVersion = 1
            custom double[] outputs:velocityCommand
        }

        def OmniGraphNode "artic"
        {
            custom double[] inputs:effortCommand
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/DiffDriveGraph/tick.outputs:tick>
            custom int[] inputs:jointIndices
            custom token[] inputs:jointNames = ["BackLeftJoint", "BackRightJoint"]
            custom double[] inputs:positionCommand
            custom string inputs:robotPath = "/World/SimpleRobot"
            custom rel inputs:targetPrim (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom double[] inputs:velocityCommand
            prepend double[] inputs:velocityCommand.connect = </World/DiffDriveGraph/diff.outputs:velocityCommand>
            token node:type = "isaacsim.core.nodes.IsaacArticulationController"
            int node:typeVersion = 1
        }
    }
}

