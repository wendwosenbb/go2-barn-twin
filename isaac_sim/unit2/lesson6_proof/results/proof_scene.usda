            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "rp"
        {
            custom rel inputs:cameraPrim = </World/Carter/Geometry/chassis_link/ChaseCam> (
                customData = {
                    dictionary omni = {
